      "id": 101,
      "title": "📈 Traffic & Throughput",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Traffic Throughput (Transactions & Queries per sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(hermespg_transactions_total[15s])",
          "legendFormat": "Transactions/s",
          "refId": "A"
        },
        {
          "expr": "rate(hermespg_queries_total[15s])",
          "legendFormat": "Queries/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "title": "Connection Acquisition Path (Fast-Path vs Slow-Path)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(hermespg_pool_acquire_fast_path_total[15s])",
          "legendFormat": "Fast-Path (Stack Hit)",
          "refId": "A"
        },
        {
          "expr": "rate(hermespg_pool_acquire_slow_path_total[15s])",
          "legendFormat": "Slow-Path (Queued)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
